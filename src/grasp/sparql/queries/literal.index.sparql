PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <http://schema.org/>
PREFIX dct:    <http://purl.org/dc/terms/>

# Default literal index query: enumerable, "free-floating" literal values
# (e.g. OSM amenity strings like "restaurant"). Excludes literals reached via
# common label predicates so that entity labels stay in the entity index.
# A literal qualifies when it appears as the object for at least 10 distinct
# (predicate, subject) pairs, which is a coarse signal that the value is
# enumerable rather than free-form text. KGs that need different filtering
# can drop a custom literal.index.sparql into the data dir and it will be
# loaded via load_index_sparql instead of this default.

SELECT DISTINCT ?id ?value ?tags WHERE {
  {
    SELECT ?id (COUNT(*) AS ?score) WHERE {
      SELECT DISTINCT ?id ?p ?s WHERE {
        ?s ?p ?id .
        FILTER(ISLITERAL(?id))
        FILTER(?p NOT IN (
          rdfs:label, rdfs:comment,
          skos:altLabel, skos:prefLabel, skos:hiddenLabel,
          schema:name, schema:description,
          dct:title, dct:description
        ))
      }
    }
    GROUP BY ?id
    HAVING (?score >= 10)
  }
  BIND(STR(?id) AS ?value)
  BIND("main" AS ?tags)
} ORDER BY DESC(?score) ?id
